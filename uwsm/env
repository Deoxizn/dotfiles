# UWSM environment (sourced shell) - cursors for Hyprland
# Required because Hyprland is started via `uwsm start` and reads these at startup.
# GTK settings (nwg-look/gsettings) do NOT affect the Hyprland compositor cursor.

# hexciri: ~/.local/bin is missing from the systemd/uwsm session PATH (it is only
# in the interactive fish PATH). Without it every hexciri-* binary is unreachable
# from keybinds — Mod+Esc, Mod+Alt+Space, Mod+Ctrl+L all silently no-op'd.
# Guarded so repeated sourcing never stacks duplicates.
case ":$PATH:" in
  *:/home/devi/.local/bin:*) ;;
  *) export PATH="/home/devi/.local/bin:$PATH" ;;
esac

export XCURSOR_THEME="Future-dark-cursors"
export XCURSOR_SIZE=24
export HYPRCURSOR_SIZE=24
