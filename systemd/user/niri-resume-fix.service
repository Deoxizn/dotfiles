[Unit]
Description=Fix DPMS wake clicks (power-on + HDMI reconfigure + bar rebind) - runs on resume only
After=suspend.target

[Service]
Type=oneshot
# Only runs on suspend resume, not on boot - use swayidle resume for DPMS
ExecStart=/bin/sh -c 'if [ -n "$NIRI_SOCKET" ] || [ -S /run/user/1000/niri.wayland-1.*.sock ]; then niri msg action power-on-monitors 2>/dev/null || true; niri msg output HDMI-A-1 transform 90 2>/dev/null || true; fi'

[Install]
WantedBy=suspend.target
