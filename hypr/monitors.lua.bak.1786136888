-- See https://wiki.hypr.land/Configuring/Basics/Monitors/
-- List current monitors and supported resolutions with: hyprctl monitors all

-- Environment variables
hl.env("GDK_SCALE", "1")

-- Dual monitor setup
hl.monitor({
  output = "HDMI-A-1",
  mode = "1920x1080@60",
  position = "0x0",
  scale = 1,
  transform = 1
})

hl.monitor({
  output = "DP-1",
  mode = "3840x2160@144",
  position = "1080x0",
  scale = 1.33,
  bitdepth = 10,
  cm = "srgb",
  supports_hdr = 1
})
