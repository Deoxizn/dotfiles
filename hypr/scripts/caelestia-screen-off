#!/bin/bash
# caelestia-screen-off — omartia remux helper for hypridle.
# Turns displays off via Hyprland's Lua dpms dispatcher, but ONLY when the
# Caelestia session lock is active, so manual locks get screens-off shortly
# after while unlocked idle is left to the normal screensaver/lock flow.

if [[ -z ${WAYLAND_DISPLAY:-} ]]; then
  socket=$(ls -t "${XDG_RUNTIME_DIR:-/run/user/$UID}"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | head -n1)
  [[ -n $socket ]] && export WAYLAND_DISPLAY=${socket##*/}
fi

locked=$(qs -c caelestia ipc call lock isLocked 2>/dev/null)
if [[ $locked != *true* ]]; then
  echo "caelestia-screen-off: not locked, skipping"
  exit 0
fi

hyprctl dispatch 'hl.dsp.dpms({ action = "off" })'
