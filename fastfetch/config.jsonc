{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "~/.config/fastfetch/htoga2.png",
    "color": { "1": "green" },
    "width": 52,
    "height": 30,
  },
  "display": {
    "separator": "  ",
  },
  "modules": [
    {
      "key": "╭───────────╮",
      "type": "custom",
    },
    {
      "key": "│ {#32}󰇅 mobo    {#keys}│",
      "type": "host",
    },
    {
      "key": "│ {#33}󰅐 uptime  {#keys}│",
      "type": "uptime",
    },
    {
      "key": "│ {#34}{icon} distro  {#keys}│",
      "type": "command",
      "text": "version=$(omarchy-version); echo \"Omarchy $version\"",
    },
    {
      "key": "│ {#35} kernel  {#keys}│",
      "type": "kernel",
    },
    {
      "key": "│ {#36}󰇄 desktop {#keys}│",
      "type": "de",
    },
    {
      "key": "│ {#31}󰖲 wm      {#keys}│",
      "type": "wm",
    },
    {
      "key": "│ {#37}󰸌 theme   {#keys}│",
      "type": "command",
      "text": "theme=$(omarchy-theme-current); echo -e \"$theme \\e[38m●\\e[37m●\\e[36m●\\e[35m●\\e[34m●\\e[33m●\\e[32m●\\e[31m●\"",
    },
    {
      "key": "│ {#32} term    {#keys}│",
      "type": "terminal",
    },
    {
      "key": "│ {#33} shell   {#keys}│",
      "type": "shell",
    },
    {
      "key": "│ {#34}󰍛 cpu     {#keys}│",
      "type": "cpu",
      "showPeCoreCount": true,
    },
    {
      "key": "│ {#35}󰍛 gpu     {#keys}│",
      "type": "gpu",
      "detectionMethod": "pci",
    },
    {
      "key": "│ {#31}󱄄 display {#keys}│",
      "type": "display",
    },
    {
      "key": "│ {#37}󰉉 disk    {#keys}│",
      "type": "disk",
      "folders": "/",
    },
    {
      "key": "│ {#32}󰏖 pkgs    {#keys}│",
      "type": "packages",
    },
    {
      "key": "│ {#33} memory  {#keys}│",
      "type": "memory",
    },
    {
      "key": "│ {#34} Snd Dev {#keys}│",
      "type": "sound",
      "format": "{2}",
    },
    {
      "key": "│ {#35}󰥠 Snd App {#keys}│",
      "type": "player",
    },
    {
      "key": "│ {#31}󰝚 Media   {#keys}│",
      "type": "media",
    },
    {
      "key": "│ {#37}󰩠 PublicIP{#keys}│",
      "type": "command",
      "text": "curl -s ifconfig.me",
    },
    {
      "key": "│ {#32}󰩠 LocalIP {#keys}│",
      "type": "localip",
      "format": "{1} - {3}",
      "showMac": true,
    },
    {
      "key": "│ {#34}󰒍 DNS     {#keys}│",
      "type": "dns",
    },
    {
      "key": "│ {#31} BT Dev   {#keys}│",
      "type": "bluetooth",
      "format": "{1} - {4}",
    },
    {
      "key": "│ {#31}󰂯 BT Ver  {#keys}│",
      "type": "bluetoothradio",
      "format": "{5}",
    },
    {
      "type": "command",
      "key": "│ {#37}󱦟 OS Age  {#keys}│",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
    },
    {
      "type": "uptime",
      "key": "│ {#32}󱫐 Uptime  {#keys}│",
    },
    {
      "type": "command",
      "key": "│ {#34} Update  {#keys}│",
      "text": "updated=$(omarchy-version-pkgs); echo \"$updated\"",
    },
    {
      "key": "╰───────────╯",
      "type": "custom",
    },
  ],
}
