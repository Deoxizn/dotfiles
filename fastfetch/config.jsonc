{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "~/.config/fastfetch/hexciri-nb.png",
    "width": 70,
    "height": 31,
    "padding": { "top": 3, "bottom": 0 },
  },
  "display": {
    "separator": "  ",
    "brightColor": false,
    "color": {
      "keys": "#99CEEF",
      "title": "#99CEEF",
      "output": "white",
      "separator": "default",
    },
    "percent": {
      "color": {
        "green": "white",
        "yellow": "white",
        "red": "white",
      },
    },
    "constants": [
      "──────────────────────────────────",
      "─────────────────────────────────",
    ],
  },
  "modules": [
    {
      "type": "custom",
      "format": "      {#30}\u001b]66;s=2;󰮯\u0007    {#31}\u001b]66;s=2;󰮯\u0007    \u001b[38;2;153;206;239m\u001b]66;s=2;󰮯\u0007    {#33}\u001b]66;s=2;󰮯\u0007    {#34}\u001b]66;s=2;󰮯\u0007    {#35}\u001b]66;s=2;󰮯\u0007    {#36}\u001b]66;s=2;󰮯\u0007    {#37}\u001b]66;s=2;󰮯\u0007",
    },
    {
      "type": "break",
    },
    {
      "type": "break",
    },
    {
      "type": "title",
      "format": "\u001b[1m\u001b[38;2;153;206;239m{user-name} @ \u001b[38;2;153;206;239m{host-name}",
    },
    {
      "type": "custom",
      "format": "   \u001b[38;2;153;206;239m►{#37} Hexciri - Arch × Niri × Noctalia",
    },
    {
      "type": "break",
    },
    {
      "type": "break",
    },

    {
      "type": "custom",
      "format": "\u001b[38;2;153;206;239m────\u001b[1;97m↳VITALS↰\u001b[0m{#37}{$1}",
    },
    {
      "type": "host",
      "key": "MOBO",
      "keyWidth": 18,
    },
    {
      "type": "command",
      "key": "AGESA",
      "keyWidth": 18,
      "text": "bios_ver=$(cat /sys/devices/virtual/dmi/id/bios_version 2>/dev/null); bios_date=$(cat /sys/devices/virtual/dmi/id/bios_date 2>/dev/null); echo \"ComboAM5 $bios_ver | $bios_date\"",
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyWidth": 18,
      "showPeCoreCount": true,
    },
    {
      "type": "command",
      "key": "GPU",
      "keyWidth": 18,
      "text": "gpu_text=$(fastfetch -s gpu 2>/dev/null | grep -oE 'NVIDIA.*|AMD.*|Intel.*' | head -5 | sed 's/ - .*//'); nvidia_driver=\"\"; if command -v nvidia-smi &>/dev/null; then nvidia_driver=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null | head -1 | cut -d. -f1); fi; result=\"\"; first=true; while IFS= read -r line; do if [[ -n \"$line\" ]]; then if [[ \"$first\" == true ]]; then first=false; else result=\"${result} | \"; fi; if [[ \"$line\" == NVIDIA* ]]; then if [[ -n \"$nvidia_driver\" ]]; then result=\"${result}${line} (${nvidia_driver})\"; else result=\"${result}${line}\"; fi; else result=\"${result}${line}\"; fi; fi; done <<< \"$gpu_text\"; echo \"$result\"",
    },
    {
      "type": "command",
      "key": "MEMORY",
      "keyWidth": 18,
      "text": "memory_info=$(fastfetch -s memory 2>/dev/null | grep -o '[0-9.]* GiB / [0-9.]* GiB ([0-9%]*)' | head -1); swap_info=$(free -h | grep Swap | awk '{print $2 \"/\" $3 \" (\" $3 \"/\" $2 \")\"}' | sed 's/Gi/GiB/g'); echo \"$memory_info | $swap_info\"",
    },
    {
      "type": "disk",
      "key": "DISK",
      "keyWidth": 18,
      "folders": "/",
    },
    {
      "type": "command",
      "key": "DISPLAY",
      "keyWidth": 18,
      "text": "fastfetch -s display 2>/dev/null | grep -oE '\\([^)]+\\).*' | sed 's/^Display //' | sed ':a;N;$!ba;s/\\n/ | /g'",
    },

    {
      "type": "break",
    },
    {
      "type": "break",
    },

    {
      "type": "custom",
      "format": "\u001b[38;2;153;206;239m────\u001b[1;97m↳SYSTEM↰\u001b[0m{#37}{$1}",
    },
    {
      "type": "command",
      "key": "OS",
      "keyWidth": 18,
      "text": "echo \"Hexciri\"",
    },
    {
      "type": "command",
      "key": "CHANNEL",
      "keyWidth": 18,
      "text": "hexciri-channel-current",
    },
    {
      "type": "command",
      "key": "VERSION",
      "keyWidth": 18,
      "text": "hexciri-version 2>/dev/null | awk '{print $1}' || echo \"?\"",
    },
    {
      "type": "command",
      "key": "KERNEL",
      "keyWidth": 18,
      "text": "uname -r",
    },
    {
      "type": "command",
      "key": "WM",
      "keyWidth": 18,
      "text": "niri_ver=$(niri --version 2>/dev/null | grep -oE '[0-9]+\\.[0-9]+' | head -1); noctalia_ver=$(pacman -Q noctalia 2>/dev/null | awk '{print $2}' | sed 's/-[0-9]*$//'); echo \"Niri ${niri_ver:-?} | Noctalia ${noctalia_ver:-?}\"",
    },
    {
      "type": "command",
      "key": "THEME",
      "keyWidth": 18,
      "text": "theme=$(hexciri-theme-current 2>/dev/null || echo \"?\"); echo -e \"$theme \\\\e[38m●\\\\e[37m●\\\\e[36m●\\\\e[35m●\\\\e[34m●\\\\e[33m●\\\\e[32m●\\\\e[31m●\"",
    },
    {
      "type": "command",
      "key": "FONT",
      "keyWidth": 18,
      "text": "f=$(grep -m1 '^font_family' \"$HOME/.config/kitty/kitty.conf\" 2>/dev/null | sed 's/^font_family *//; s/[[:space:]]*$//'); [ -n \"$f\" ] && { echo \"$f\"; exit 0; }; fc-match --format '%{family[0]}' 2>/dev/null",
    },
    {
      "type": "packages",
      "key": "PKGS",
      "keyWidth": 18,
    },

    {
      "type": "break",
    },
    {
      "type": "break",
    },

    {
      "type": "custom",
      "format": "\u001b[38;2;153;206;239m────\u001b[1;97m↳SESSION↰\u001b[0m{#37}{$2}",
    },
    {
      "type": "uptime",
      "key": "UPTIME",
      "keyWidth": 18,
    },
    {
      "type": "command",
      "key": "UPDATED",
      "keyWidth": 18,
      "text": "tac /var/log/pacman.log 2>/dev/null | grep -m1 'starting full system upgrade' | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]+' | tr 'T' ' '",
    },
    {
      "type": "command",
      "key": "AGE",
      "keyWidth": 18,
      "text": "birth=$(stat -c %W /); now=$(date +%s); echo \"$(( (now - birth) / 86400 )) days old\"",
    },
    {
      "type": "command",
      "key": "TERM",
      "keyWidth": 18,
      "text": "terminal_info=$(fastfetch -s terminal 2>/dev/null | grep -o '[a-zA-Z]* [0-9][^[:space:]]*' | head -1); echo \"${terminal_info:-$TERM}\"",
    },
    {
      "type": "shell",
      "key": "SHELL",
      "keyWidth": 18,
    },
    {
      "type": "command",
      "key": "MEDIA",
      "keyWidth": 18,
      "text": "media_json=$(fastfetch -s media --format json 2>/dev/null); player_name=$(echo \"$media_json\" | jq -r '.[0].result.player.name // \"No player\"' 2>/dev/null); artist=$(echo \"$media_json\" | jq -r '.[0].result.song.artist // empty' 2>/dev/null); name=$(echo \"$media_json\" | jq -r '.[0].result.song.name // empty' 2>/dev/null); if [[ -n \"$artist\" && -n \"$name\" ]]; then song_info=\"$artist - $name\"; else song_info=\"\"; fi; echo \"$player_name${song_info:+ | $song_info}\"",
    },
    {
      "type": "command",
      "key": "DEVICES",
      "keyWidth": 18,
      "text": "bt=$(fastfetch -s bluetooth --format json 2>/dev/null | jq -r '.[0].result[] | \"\\(.name) \\(.battery)%\"' | paste -sd ' | ' -); razer=$(python3 -c 'import openrazer.client; m=openrazer.client.DeviceManager(); [print(d.name.split(\"(\")[0].strip() + \" \" + str(d.battery_level) + \"%\") for d in m.devices]' 2>/dev/null | paste -sd ' | ' -); echo \"${bt}${bt:+ | }${razer}\"",
    },

    {
      "type": "break",
    },
    {
      "type": "break",
    },

    {
      "type": "custom",
      "format": "      {#90}\u001b]66;s=2;󰊠\u0007    {#91}\u001b]66;s=2;󰊠\u0007    \u001b[38;2;153;206;239m\u001b]66;s=2;󰊠\u0007    {#93}\u001b]66;s=2;󰊠\u0007    {#94}\u001b]66;s=2;󰊠\u0007    {#95}\u001b]66;s=2;󰊠\u0007    {#96}\u001b]66;s=2;󰊠\u0007    {#97}\u001b]66;s=2;󰊠\u0007",
    },

    {
      "type": "break",
    },
  ],
}
