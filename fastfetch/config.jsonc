{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "~/.config/fastfetch/ascii-art.png",
    "color": { "1": "green" },
    "width": 62,
    "height": 27,
    "padding": {
      "top": 2,
      "right": 6,
      "left": 2,
    },
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Hardware──────────────────────┐",
    },
    {
      "type": "host",
      "key": " PC",
      "keyColor": "green",
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "showPeCoreCount": true,
      "keyColor": "green",
    },
    {
      "type": "bootmgr",
      "key": "│ ├",
      "keyColor": "green",
    },
    {
      "type": "gpu",
      "key": "│ ├",
      "detectionMethod": "pci",
      "keyColor": "green",
    },
    {
      "type": "display",
      "key": "│ ├󱄄",
      "keyColor": "green",
    },
    {
      "type": "disk",
      "key": "│ ├󰋊",
      "keyColor": "green",
    },
    {
      "type": "memory",
      "key": "│ ├",
      "keyColor": "green",
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────Software──────────────────────┐",
    },
    {
      "type": "command",
      "key": "\ue900 OS",
      "keyColor": "blue",
      "text": "version=$(omarchy-version); echo \"Omarchy $version\"",
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "blue",
    },
    {
      "type": "wm",
      "key": "│ ├",
      "keyColor": "blue",
    },
    {
      "type": "de",
      "key": " DE",
      "keyColor": "blue",
    },
    {
      "type": "terminal",
      "key": "│ ├",
      "keyColor": "blue",
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "blue",
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉼",
      "keyColor": "blue",
    },
    {
      "type": "command",
      "key": "│ ├󰸌",
      "keyColor": "blue",
      "text": "theme=$(omarchy-theme-current); echo -e \"$theme \\e[38m●\\e[37m●\\e[36m●\\e[35m●\\e[34m●\\e[33m●\\e[32m●\\e[31m●\"",
    },
    {
      "type": "terminalfont",
      "key": "└ └",
      "keyColor": "blue",
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────Audio───────────────┐",
    },
    {
      "type": "sound",
      "key": " AUDIO",
      "format": "{2}",
      "keyColor": "magenta",
    },
    {
      "type": "player",
      "key": "└ └󰥠",
      "keyColor": "magenta",
    },
    {
      "type": "media",
      "key": "└ └󰝚",
      "keyColor": "magenta",
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────Network───────────────┐",
    },
    {
      "type": "publicip",
      "key": "󰩠Pubic",
      "keyColor": "magenta",
      "format": "{1} - {2}",
    },
    {
      "type": "localip",
      "key": "󰩠Local",
      "keyColor": "magenta",
      "format": "{1} - {3}",
      "showMac": true,
    },
    {
      "type": "dns",
      "key": "└ └󰒍 DNS   ",
      "keyColor": "magenta",
    },
    {
      "type": "wifi",
      "key": "└ └ Wi-Fi ",
      "keyColor": "magenta",
      "format": "{4} - {7} - {13} GHz - {6} - {10}",
    },
    {
      "type": "bluetooth",
      "key": "└ └ BT Dev",
      "keyColor": "magenta",
      "format": "{1} - {4}",
    },
    {
      "type": "bluetoothradio",
      "key": "└ └󰂯 BT Ver",
      "keyColor": "magenta",
      "format": "{5}",
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────OS Age / Uptime / Updated───────────────┐",
    },
    {
      "type": "command",
      "key": "󱦟OS Age",
      "keyColor": "magenta",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
    },
    {
      "type": "uptime",
      "key": "└ └󱫐 Uptime",
      "keyColor": "magenta",
    },
    {
      "type": "command",
      "key": "└ └ Update",
      "keyColor": "magenta",
      "text": "updated=$(omarchy-version-pkgs); echo \"$updated\"",
    },
    {
      "type": "custom",
      "format": "\u001b[90m└────────────────────────────────────────────────────┘",
    },
    "break",
  ],
}
