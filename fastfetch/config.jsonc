{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "~/.config/fastfetch/frieren.png",
    "color": { "1": "green" },
    "width": 80,
    "height": 30,
  },
  "display": {
    "separator": "  ",
  },
  "modules": [
    {
      "type": "break",
    },
    {
      "type": "break",
    },
    {
      "type": "break",
    },
    {
      "type": "break",
    },
    {
      "type": "break",
    },
    {
      "type": "break",
    },
    {
      "key": "╭───────────╮",
      "type": "custom",
    },
    {
      "key": "│ {#32}󰇅 mobo    {#keys}│",
      "type": "host",
    },
    {
      "key": "│ {#33}\ue900  ver    {#keys}│",
      "type": "command",
      "text": "version=$(omarchy-version); kernel=$(uname -r); echo \"Omarchy $version | $kernel\"",
    },
    {
      "key": "│ {#36}󰇄 desktop {#keys}│",
      "type": "de",
    },
    {
      "key": "│ {#31}󰖲 wm      {#keys}│",
      "type": "wm",
    },
    {
      "key": "│ {#37}󰸌 theme   {#keys}│",
      "type": "command",
      "text": "theme=$(omarchy-theme-current); echo -e \"$theme \\e[38m●\\e[37m●\\e[36m●\\e[35m●\\e[34m●\\e[33m●\\e[32m●\\e[31m●\"",
    },
    {
      "key": "│ {#32} term    {#keys}│",
      "type": "command",
      "text": "fish_version=$(fish --version 2>/dev/null | grep -o '[0-9]\\+\\.[0-9]\\+\\.[0-9]\\+' | head -1); terminal_info=$(fastfetch -s terminal 2>/dev/null | grep -o '[a-zA-Z]* [0-9][^[:space:]]*' | head -1); echo \"${terminal_info:-$TERM} | fish ${fish_version:+$fish_version}\"",
    },
    {
      "key": "│ {#33}󰍛 cpu     {#keys}│",
      "type": "cpu",
      "showPeCoreCount": true,
    },
    {
      "key": "│ {#35}󰍛 gpu     {#keys}│",
      "type": "gpu",
      "detectionMethod": "pci",
    },
    {
      "key": "│ {#31}󱄄 display {#keys}│",
      "type": "display",
    },
    {
      "key": "│ {#37}󰉉 disk    {#keys}│",
      "type": "disk",
      "folders": "/",
    },
    {
      "key": "│ {#32}󰏖 pkgs    {#keys}│",
      "type": "packages",
    },
    {
      "key": "│ {#33} memory  {#keys}│",
      "type": "command",
      "text": "memory_info=$(fastfetch -s memory 2>/dev/null | grep -o '[0-9.]* GiB / [0-9.]* GiB ([0-9%]*)' | head -1); swap_info=$(free -h | grep Swap | awk '{print $2 \"/\" $3 \" (\" $3 \"/\" $2 \")\"}' | sed 's/Gi/GiB/g'); echo \"$memory_info | $swap_info\"",
    },
    {
      "key": "│ {#35}󰥠 Plr|Mda {#keys}│",
      "type": "command",
      "text": "media_json=$(fastfetch -s media --format json 2>/dev/null); player_name=$(echo \"$media_json\" | jq -r '.[0].result.player.name // \"No player\"' 2>/dev/null); artist=$(echo \"$media_json\" | jq -r '.[0].result.song.artist // empty' 2>/dev/null); name=$(echo \"$media_json\" | jq -r '.[0].result.song.name // empty' 2>/dev/null); if [[ -n \"$artist\" && -n \"$name\" ]]; then song_info=\"$artist - $name\"; else song_info=\"\"; fi; echo \"$player_name${song_info:+ | $song_info}\"",
    },
    {
      "key": "│ {#31} BT Dev   {#keys}│",
      "type": "bluetooth",
      "format": "{1} - {4}",
    },
    {
      "type": "command",
      "key": "│ {#33}󱫐 OS Time {#keys}│",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); uptime_info=$(uptime -p 2>/dev/null | sed 's/up //'); echo \"$days_difference days old | $uptime_info of uptime\"",
    },
    {
      "type": "command",
      "key": "│ {#34} Updated {#keys}│",
      "text": "updated=$(omarchy-version-pkgs); echo \"$updated\"",
    },
    {
      "key": "╰───────────╯",
      "type": "custom",
    },
  ],
}
