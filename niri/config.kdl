// Hexciri — Niri config
// https://github.com/deoxizn/hexciri
//
// Hexciri-flavored binds (hexciri-menu, hexciri-fuzzel, hexciri-lock, ...).
// Personal edits are kept by the framework (deploy() is sha-tracked); use the
// Themes menu for theme/palette changes, bars/wallpapers from Noctalia.
//
// Niri uses KDL format. Each section controls a different part of the desktop.
// Comments start with // — uncomment a line to enable it, add // to disable it.
// After editing, run: niri msg action load-config-file  (or reload from Noctalia)

// ──────────────────────────────────────────────
// Environment variables
// These are passed to every app you launch. They tell Qt, Electron, Java, GTK,
// Firefox, etc. to use Wayland instead of falling back to X11.
// ──────────────────────────────────────────────

environment {
    PATH "/home/devi/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/bin:/usr/bin/site_perl:/usr/bin/vendor_perl:/usr/bin/core_perl"
    QT_QPA_PLATFORM "wayland;xcb"               // Qt apps: prefer Wayland, fall back to X11
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"     // Qt apps: disable client-side decorations
    // NOTE: do NOT set DISPLAY null here — it unsets DISPLAY for every Niri
    // spawn, breaking X11-only codepaths (Steam updater, Proton, xdotool...).
    // xwayland-satellite already provides :0; Wayland-native apps still prefer
    // Wayland via the *_WAYLAND_*/GDK/MOZ hints below. X11 is fallback, not default.
    ELECTRON_OZONE_PLATFORM_HINT "auto"         // Electron apps (VS Code, Discord): auto-detect Wayland
    _JAVA_AWT_WM_NONREPARENTING "1"            // Java AWT apps: work correctly on Wayland
    XDG_CURRENT_DESKTOP "niri"                  // Tells apps which desktop environment is running
    XDG_SESSION_TYPE "wayland"                  // Tells apps this is a Wayland session
    MOZ_ENABLE_WAYLAND "1"                      // Firefox: use native Wayland
    CLUTTER_BACKEND "wayland"                   // Clutter apps: use Wayland backend
    SDL_VIDEODRIVER "wayland,x11"               // SDL apps (games): prefer Wayland, fall back to X11
    GDK_BACKEND "wayland,x11"                   // GTK apps: prefer Wayland, fall back to X11
}

// ──────────────────────────────────────────────
// Cursor settings
// ──────────────────────────────────────────────

cursor {
    xcursor-theme "Future-dark-cursors"    // Cursor theme name (change to match your installed theme)
    xcursor-size 24                        // Cursor size in pixels
    hide-when-typing                       // Hide cursor while typing
    hide-after-inactive-ms 1000            // Hide cursor after 1 second of inactivity
}

// ──────────────────────────────────────────────
// Output / Monitor config
// Define your monitors and their layout. Use "niri msg outputs" to see detected outputs.
// Format: output "NAME" { mode "WIDTHxHEIGHT@REFRESH"; position x=X y=Y; }
// "scale" = UI scaling (1.0 = native, 1.33 = 150% scaling on 4K, etc.)
// "transform" = rotation ("90" = 90° clockwise, "180" = upside down)
// ──────────────────────────────────────────────

output "DP-4" {
    mode "3840x2160@144"                    // ASUS VG28UQL1A 4K at 144Hz
    scale 1.5                               // UI scaling (4K at 1.5 ≈ 2560x1440 logical)
    position x=1080 y=0                     // To the right of the rotated 1080p monitor
    variable-refresh-rate                   // Enable VRR (reduces screen tearing in games)
}

output "HDMI-A-2" {
    mode "1920x1080@60"                     // Dell P2212H 1080p at 60Hz
    transform "90"                          // Rotated 90° (portrait)
    position x=0 y=0                        // Positioned at left
}

// ──────────────────────────────────────────────
// Input device settings
// ──────────────────────────────────────────────

input {
    keyboard {
        xkb {
            layout "us"                      // Keyboard layout (us, gb, de, etc.)
            // options "ctrl:nocaps"          // Uncomment to make CapsLock act as Ctrl
        }
        numlock                              // Enable Num Lock on startup
    }

    touchpad {
        tap                                 // Enable tap-to-click
        natural-scroll                      // Scroll direction matches content movement
        // disabled-while-typing is on by default
    }

    mouse {
        // natural-scroll                   // Uncomment to reverse scroll direction on mouse
    }

    // focus-follows-mouse                  // Uncomment: focus windows just by hovering over them
    // focus-follows-mouse-delay 250        // Delay before focusing (ms) — only works with focus-follows-mouse
    // scroll-factor 3                      // Multiply scroll speed (useful for touchpads)
}

// ──────────────────────────────────────────────
// Layout
// Controls spacing, borders, shadows, and how windows are arranged.
// ──────────────────────────────────────────────

layout {
    gaps 0                                  // Pixel gap between windows
    center-focused-column "on-overflow"     // Center the focused column when it overflows the screen

    // Preset column widths you can cycle through with Mod+R
    preset-column-widths {
        proportion 0.33333                  // 1/3 of screen width
        proportion 0.5                      // 1/2 of screen width
        proportion 0.66667                  // 2/3 of screen width
    }

    default-column-width { proportion 0.5; }  // New windows open at half screen width

    // Focus ring — thin highlight around the active window
    focus-ring {
        width 2
        active-color "#99CEEF"              // Color of the focused window's ring
        inactive-color "#63677F"            // Color of unfocused windows' ring
    }

    // Border — thicker outline around all windows
    border {
        on                                  // Enable borders (set to "off" to disable)
        width 1
        active-color "#99CEEF"              // Focused window border color
        inactive-color "#63677F"            // Unfocused window border color
        urgent-color "#f87171"              // Urgent window border color (e.g. notification)
    }

    // Drop shadow behind windows
    shadow {
        on                                  // Enable shadows (set to "off" to disable)
        softness 30                         // Shadow blur radius
        spread 5                            // How far the shadow extends
        offset x=0 y=5                      // Shadow offset (x=horizontal, y=vertical)
        color "#0007"                       // Shadow color with alpha (0007 = semi-transparent black)
    }

    struts {
        // left 64                          // Space reserved on left edge (for panels/bars)
        // right 64                         // Space reserved on right edge
        // top 64                           // Space reserved on top edge
        // bottom 64                        // Space reserved on bottom edge
    }
}

// ──────────────────────────────────────────────
// Animations
// Controls how windows move, open, close, and switch.
// "spring" = physics-based (bouncy feel). "duration-ms" = fixed time.
// damping-ratio: 1.0 = no bounce, <1.0 = bouncy, >1.0 = overdamped
// stiffness: higher = faster/snappier
// ──────────────────────────────────────────────

animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001    // Snappy, no bounce
    }

    window-open {
        duration-ms 150
        curve "ease-out-expo"               // Fast start, slows down at end
    }

    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    overview-open-close {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }
}

// ──────────────────────────────────────────────
// Overview (Mod+O)
// Shows a zoomed-out view of all your workspaces.
// ──────────────────────────────────────────────

overview {
    zoom 0.5                                // How much to zoom out (0.5 = half size)
    backdrop-color "#262626"                // Background color behind workspaces
}

// ──────────────────────────────────────────────
// Workspaces — per-monitor (Hyprland-style)
// Mod+1-9 stays on current monitor
// ──────────────────────────────────────────────

// ──────────────────────────────────────────────
// Keybindings
// Niri has NO default binds — you must define ALL of them yourself.
// "Mod" = Super/Windows key. Mirrors Omarchy conventions where possible.
// Format: Mod+Key { action; }
// ──────────────────────────────────────────────

binds {
    // ── Launcher & menus ──
    Mod+Space { spawn "hexciri-fuzzel"; }                     // App launcher (fuzzel)
    Mod+D { spawn "noctalia" "msg" "panel-toggle" "launcher"; } // Noctalia launcher panel
    Mod+Alt+Space { spawn "hexciri-menu"; }                    // Hexciri root menu
    Mod+K { spawn "hexciri-keybinds"; }                        // Show keybinding reference

    // ── Terminal ──
    Mod+Return { spawn "bash" "-c" "~/.config/niri/scripts/terminal-smart.sh"; }  // Open terminal (smart: tab into running kitty)
    Mod+grave { spawn "hexciri-agent"; }                         // Open coding agent (opencode)

    // ── Apps ──
    Mod+Shift+B { spawn "xdg-open" "https://"; }               // Open browser
    Mod+Shift+E { spawn "zeditor"; }                            // Open editor (zed)
    Mod+Shift+F { spawn "~/.local/bin/strata"; }
    Mod+Shift+M { spawn "spotify"; }                            // Open Spotify
    Mod+Ctrl+D { spawn "vesktop"; }                             // Open Vesktop (Discord)
    Mod+Ctrl+M { spawn "hexciri-launch-or-focus-webapp" "messenger" "https://www.messenger.com"; }  // Messenger webapp
    XF86Tools { spawn "kitty" "--class=app.hexciri.ff" "fish" "-c" "ff; exec fish"; }  // Fastfetch in floating window (XF86Tools key)
    XF86Launch5 { spawn "hexciri-launch-or-focus-webapp" "gemini" "https://gemini.google.com/app"; }  // Gemini webapp
    XF86Launch6 { spawn "hexciri-launch-or-focus-webapp" "photopea" "https://photopea.com"; }           // Photopea webapp

    // ── Close & quit ──
    Mod+Q { close-window; }                                     // Close focused window

    // ── Focus (arrow keys) ──
    Mod+Left { focus-column-left; }                             // Focus window to the left
    Mod+Right { focus-column-right; }                           // Focus window to the right
    Mod+Down { focus-window-down; }                             // Focus window below
    Mod+Up { focus-window-up; }                                 // Focus window above

    // ── Move (arrow keys) ──
    Mod+Ctrl+Left { move-column-left; }                         // Move window left
    Mod+Ctrl+Right { move-column-right; }                       // Move window right
    Mod+Ctrl+Down { move-window-down; }                         // Move window down
    Mod+Ctrl+Up { move-window-up; }                             // Move window up

    // ── Focus (vim-style) ──
    Mod+H { focus-column-left; }                                // Focus left (H key)
    Mod+L { focus-column-right; }                               // Focus right (L key)
    Mod+J { focus-window-down; }                                // Focus down (J key)

    // ── Move (vim-style) ──
    Mod+Ctrl+H { move-column-left; }                            // Move left (H key)
    Mod+Ctrl+J { move-window-down; }                            // Move down (J key)
    Mod+Ctrl+K { move-window-up; }                              // Move up (K key)

    // ── Workspaces ──
    // Switch to workspace 1-9 by pressing Mod+1-9
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    // Move current window to workspace 1-9 with Mod+Shift+1-9
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // ── Workspace navigation ──
    Mod+U { focus-workspace-down; }                             // Go to workspace below
    Mod+I { focus-workspace-up; }                               // Go to workspace above
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }  // Scroll to workspace below
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }      // Scroll to workspace above
    Mod+Shift+Down { move-column-to-workspace-down; }          // Move window to workspace below
    Mod+Shift+Up { move-column-to-workspace-up; }              // Move window to workspace above

    // ── Column management ──
    Mod+BracketLeft { consume-window-into-column; }             // Pull window into adjacent column
    Mod+BracketRight { expel-window-from-column; }              // Push window out of column
    Mod+F { maximize-column; }                                  // Maximize column to fill screen
    Mod+Ctrl+F { fullscreen-window; }                           // Fullscreen the window
    Mod+R { switch-preset-column-width; }                       // Cycle column width (1/3 → 1/2 → 2/3)
    Mod+Shift+R { toggle-column-tabbed-display; }               // Toggle tabbed view in column

    // ── Floating ──
    Mod+Shift+Space { toggle-window-floating; }                 // Toggle window between tiled/floating
    Mod+P { focus-floating; }                                   // Jump focus to floating window
    Mod+Shift+P { focus-tiling; }                               // Jump focus back to tiled window

    // ── Screenshots & recording ──
    Mod+Print { screenshot; }                                           // Interactive select: drag region or click window (file + clipboard)
    Ctrl+Print { spawn-sh "grim - | wl-copy"; }                         // Screenshot full screen → clipboard
    Alt+Print { spawn "hexciri-screenrecord"; }                       // Toggle screen recording

    // ── Clipboard (wtype for GUI apps, terminals use Shift+Ctrl+C/V) ──
    Mod+C { spawn-sh "wtype -M ctrl -k c"; }                    // Copy (works in GUI apps)
    Mod+V { spawn-sh "wtype -M ctrl -k v"; }                    // Paste (works in GUI apps)
    Mod+X { spawn-sh "wtype -M ctrl -k x"; }                    // Cut (works in GUI apps)

    // ── Media keys ──
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+"; }    // Volume up
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }    // Volume down
    XF86AudioMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }           // Mute/unmute
    XF86AudioMicMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }     // Mute/unmute mic
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }                                   // Play/pause media
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }                                     // Previous track
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }                                         // Next track

    // ── Brightness ──
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }     // Brightness up
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }   // Brightness down

    // ── Lock ──
    Mod+Ctrl+L { spawn "hexciri-lock"; }                     // Lock screen + monitors off after 20s

    // ── Clipboard history ──
    Mod+Ctrl+V { spawn "hexciri-clipboard"; }                     // Clipboard history picker

    // ── Notifications ──
    Mod+Comma { spawn "noctalia" "msg" "notification-clear-active"; }   // Clear active notifications
    Mod+Ctrl+Comma { spawn "noctalia" "msg" "notification-clear-active"; }   // Clear active notifications
    Mod+Ctrl+Period { spawn "noctalia" "msg" "notification-clear-history"; }  // Clear notification history

    // ── Overview ──
    Mod+O { toggle-overview; }                                  // Toggle workspace overview

    // ── Power menu ──
    Mod+Escape { spawn "hexciri-power"; }                     // Open power menu

    // ── Noctalia-specific ──
    Mod+N { spawn "noctalia" "msg" "panel-toggle" "notifications"; }   // Toggle notification panel
}

// ──────────────────────────────────────────────
// Window rules
// Each rule matches a window by app-id and applies behavior.
// Rules are processed in order — put specific rules before general ones.
// "open-floating true" = window opens as a floating popup (not tiled)
// "open-maximized true" = window opens filling its column
// "open-on-workspace" = send window to a specific workspace on open
// "open-fullscreen true" = window opens in fullscreen
// ──────────────────────────────────────────────

// Floating dialogs — these apps always open as floating popups
window-rule {
    match app-id="pavucontrol"              // PulseAudio volume control
    open-floating true
}

window-rule {
    match app-id="nm-connection-editor"     // Network Manager connection editor
    open-floating true
}

window-rule {
    match app-id="blueman-manager"          // Bluetooth manager
    open-floating true
}

window-rule {
    match app-id="org.gnome.Calculator"     // GNOME Calculator
    open-floating true
}

window-rule {
    match app-id="org.gnome.Settings"       // GNOME Settings
    open-floating true
}

window-rule {
    match app-id="feh"                      // Image viewer
    open-floating true
}

window-rule {
    match app-id="imv"                      // Image viewer (wayland-native)
    open-floating true
}

// LocalSend — floating at 1100x700 (matching Hyprland localsend.lua)
window-rule {
    match app-id="localsend"
    match title="Share"
    open-floating true
    default-column-width { fixed 1100; }
    default-window-height { fixed 700; }
}

// Speedtest (fast.com) — floating for gauges
window-rule {
    match app-id=".*fast\\.com.*"
    open-floating true
    default-column-width { fixed 1100; }
    default-window-height { fixed 700; }
}

// Media player — floating (sizing handled by mpv config)
window-rule {
    match app-id="mpv"                      // Video player
    open-floating true
}

// Webcam overlay — floating (hexciri-screenrecord --with-webcam)
window-rule {
    match app-id="WebcamOverlay"
    open-floating true
}

// TUI apps — float at 1000x720, centered
// Used by hexciri-agent (opencode), hexciri-install, hexciri-themes, hexciri-remove, etc.
// background-effect blurs the wallpaper behind the host terminal so its reduced
// background_opacity reads as soft translucency — same as the kitty rule.
window-rule {
    match app-id="TUI\\.float"             // Matches apps launched with --app-id=TUI.float
    open-floating true
    default-column-width { fixed 1000; }    // Fixed width in pixels
    default-window-height { fixed 720; }    // Fixed height in pixels
    background-effect {
        blur true
    }
}

// Default terminal — opens at half screen width
window-rule {
    match app-id="Alacritty"
    default-column-width { proportion 0.5; }
}

// Fastfetch — personal floating window
// Launched via XF86Tools key. Adjust width/height below to fit your screen.
window-rule {
    match app-id="app.hexciri.ff"
    open-floating true
    default-column-width { fixed 1550; }    // ← adjust width here
    default-window-height { fixed 720; }    // ← adjust height here
}

// Workspace assignments
// DP-4: ws1=browser, ws2=files, ws3=spotify, ws4=games
// HDMI-A-2: ws1=vesktop, ws2=messenger, ws3=terminal

// Browser — always opens on workspace 1
window-rule {
    match app-id="zen|zen-alpha|zen-beta"
    open-on-workspace "1"
    open-maximized true
}

window-rule {
    match app-id="chromium"
    open-on-workspace "1"
    open-maximized true
}

window-rule {
    match app-id="brave-browser"
    open-on-workspace "1"
    open-maximized true
}

window-rule {
    match app-id="firefox"
    open-on-workspace "1"
    open-maximized true
}

// File manager — always opens on workspace 2, maximized (Strata)
window-rule {
    match app-id="io.github.lgse.Strata"
    open-on-workspace "2"
    open-maximized true
}

// Spotify — always opens on workspace 3, maximized
window-rule {
    match app-id="spotify"
    open-on-workspace "3"
    open-maximized true
}

// Messenger webapp — full width
window-rule {
    match app-id="brave-www.messenger.com__-Default"
    default-column-width { proportion 1.0; }
    open-maximized true
}

// Gemini webapp — full width
window-rule {
    match app-id="brave-gemini.google.com__app-Default"
    default-column-width { proportion 1.0; }
    open-maximized true
}

// Photopea webapp — full width
window-rule {
    match app-id="brave-photopea.com__-Default"
    default-column-width { proportion 1.0; }
    open-maximized true
}

// Games — always opens on workspace 4, maximized
window-rule {
    match app-id="steam|steamwebhelper|steam_app"
    open-on-workspace "4"
    open-maximized true
}

// World of Warcraft — fullscreen on the gaming monitor (DP-4)
window-rule {
    match app-id="wow.exe"
    open-on-output "DP-4"                   // Open on specific monitor
    open-on-workspace "4"
    open-fullscreen true
}

// Vesktop/Discord — always opens on workspace 1, maximized
window-rule {
    match app-id="discord|vesktop"
    open-on-workspace "1"
    open-maximized true
}

// Messenger (native app) — always opens on workspace 2, maximized
window-rule {
    match app-id="Messenger"
    open-on-workspace "2"
    open-maximized true
}

// Terminal — opens on current workspace
// (HDMI-A-2 ws3 doesn't exist yet; rule removed)

// ──────────────────────────────────────────────
// Layer rules
// Apply effects to layer-shell surfaces (panels, overlays, launchers).
// "blur true" makes the background see-through with a blur effect.
// ──────────────────────────────────────────────

layer-rule {
    match namespace="fuzzel"                // Fuzzel app launcher
    background-effect {
        blur true
    }
}

layer-rule {
    match namespace="noctalia"              // Noctalia shell (bar, launcher, etc.)
    background-effect {
        blur true
    }
}

// ──────────────────────────────────────────────
// Opacity rules
// Make terminal and app windows slightly transparent.
// Opacity: 0.0 = fully transparent, 1.0 = fully opaque.
// "draw-border-with-background false" = border doesn't obscure the wallpaper.
// ──────────────────────────────────────────────

window-rule {
    match app-id="alacritty"
    opacity 0.85                            // 85% opaque
}

window-rule {
    match app-id="kitty"
    opacity 0.85
    draw-border-with-background false       // Border is see-through
}

window-rule {
    match app-id="app.hexciri.ff"         // Fastfetch window
    opacity 0.85
    draw-border-with-background false
}

window-rule {
    match app-id="foot"
    opacity 0.85
}

window-rule {
    match app-id="io.github.lgse.Strata"
    opacity 0.90                            // 90% opaque (slightly less transparent)
}

// ──────────────────────────────────────────────
// Spawn at startup
// Programs that start automatically when you log in.
// ──────────────────────────────────────────────

spawn-at-startup "hexciri-theme-ensure"    // First login: re-apply the active theme if the chroot seed left it dormant (does nothing once live)
spawn-at-startup "noctalia"                 // Noctalia shell (bar, notifications, etc.)
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"   // Polkit auth dialogs (vanilla GNOME agent)
spawn-at-startup "swayidle" "-w" "timeout" "600" "niri msg action power-off-monitors" "resume" "niri msg action power-on-monitors"   // DPMS off after 10 min idle, power on on resume/wake
spawn-sh-at-startup "systemctl --user import-environment $(env | cut -d= -f1) && dbus-update-activation-environment --systemd --all"   // Import env into systemd/dbus
spawn-sh-at-startup "sleep 2 && openrgb-start"   // Start OpenRGB with 2s delay (for Wayland to be ready)

// ──────────────────────────────────────────────
// Xwayland
// Runs X11 apps under Wayland via xwayland-satellite.
// Needed for older apps that don't support Wayland natively.
// ──────────────────────────────────────────────

xwayland-satellite { path "xwayland-satellite"; }

// ──────────────────────────────────────────────
// Clipboard
// Disables the X11 primary selection (middle-click paste).
// Only Ctrl+C/V/X clipboard works.
// ──────────────────────────────────────────────

clipboard { disable-primary; }

// ──────────────────────────────────────────────
// Blur settings
// Controls the blur effect applied by layer rules above.
// Higher passes = stronger blur. Higher offset = more spread.
// ──────────────────────────────────────────────

blur {
    passes 3                                // Number of blur passes (more = stronger blur)
    offset 3.0                              // Blur spread distance
    noise 0.02                              // Subtle noise texture
    saturation 1.5                          // Color saturation boost
}

// ──────────────────────────────────────────────
// Hotkey overlay
// The "Important Hotkeys" popup that shows on startup.
// ──────────────────────────────────────────────

hotkey-overlay {
    skip-at-startup                         // Don't show the overlay when Niri starts
    hide-not-bound                          // Hide keybinds that aren't bound to any key
}

// ──────────────────────────────────────────────
// Config notification
// Shows a notification when the config fails to load.
// ──────────────────────────────────────────────

config-notification {
    // disable-failed                       // Uncomment to suppress config error notifications
}

// ──────────────────────────────────────────────
// Screenshot path
// Where screenshots are saved when using Ctrl+Print or Alt+Print.
// %Y-%m-%d %H-%M-%S is replaced with the current date/time.
// ──────────────────────────────────────────────

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// ──────────────────────────────────────────────
// Prefer no CSD
// Ask apps to not draw their own title bar decorations.
// Niri will draw server-side decorations instead.
// ──────────────────────────────────────────────

prefer-no-csd
