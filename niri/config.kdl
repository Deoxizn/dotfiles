// Noctarchy — Niri config
// https://github.com/deoxizn/noctarchy
//
// Based on Omarchy keybind conventions adapted for Niri's scrollable tiling.
// This file is managed by noctarchy — personal edits go in a separate include
// or above the managed sections.

// ──────────────────────────────────────────────
// Environment
// ──────────────────────────────────────────────

environment {
    QT_QPA_PLATFORM "wayland;xcb"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    DISPLAY null
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    _JAVA_AWT_WM_NONREPARENTING "1"
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    MOZ_ENABLE_WAYLAND "1"
    CLUTTER_BACKEND "wayland"
    SDL_VIDEODRIVER "wayland"
    GDK_BACKEND "wayland,x11"
}

// ──────────────────────────────────────────────
// Cursor
// ──────────────────────────────────────────────

cursor {
    xcursor-theme "breeze_cursors"
    xcursor-size 24
    hide-when-typing
    hide-after-inactive-ms 1000
}

// ──────────────────────────────────────────────
// Output / Monitor config
// ──────────────────────────────────────────────

output "HDMI-A-1" {
    mode "1920x1080@60"
    transform "90"
    position x=0 y=0
}

output "DP-1" {
    mode "3840x2160@144"
    scale 1.33
    position x=1080 y=0
    variable-refresh-rate
}

// ──────────────────────────────────────────────
// Input
// ──────────────────────────────────────────────

input {
    keyboard {
        xkb {
            layout "us"
            // options "ctrl:nocaps"
        }
    }

    touchpad {
        tap
        natural-scroll
        // disabled-while-typing is on by default
    }

    mouse {
        // natural-scroll
    }

    // focus-follows-mouse
    // focus-follows-mouse-delay 250
    // scroll-factor 3
}

// ──────────────────────────────────────────────
// Layout
// ──────────────────────────────────────────────

layout {
    gaps 16
    center-focused-column "on-overflow"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 4
        active-color "#7aa2f7"
        inactive-color "#414868"
    }

    border {
        on
        width 2
        active-color "#7aa2f7"
        inactive-color "#414868"
        urgent-color "#f87171"
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    struts {
        // left 64
        // right 64
        // top 64
        // bottom 64
    }
}

// ──────────────────────────────────────────────
// Animations
// ──────────────────────────────────────────────

animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    window-open {
        duration-ms 150
        curve "ease-out-expo"
    }

    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    overview-open-close {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }
}

// ──────────────────────────────────────────────
// Overview
// ──────────────────────────────────────────────

overview {
    zoom 0.5
    backdrop-color "#262626"
}

// ──────────────────────────────────────────────
// Workspaces — per-monitor (Hyprland-style)
// Mod+1-9 stays on current monitor
// ──────────────────────────────────────────────

// ──────────────────────────────────────────────
// Keybindings
// Niri has NO default binds — you must define ALL of them.
// Mirrors Omarchy conventions where possible (SUPER = Mod).
// ──────────────────────────────────────────────

binds {
    // ── Launcher & menus ──
    Mod+Space { spawn "noctarchy-fuzzel"; }
    Mod+D { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+Alt+Space { spawn "noctarchy-menu"; }
    Mod+Alt+W { spawn "bash" "-c" "~/.config/niri/scripts/noctarchy-wallpaper-reset"; }
    Mod+K { spawn "noctarchy-keybinds"; }

    // ── Terminal ──
    Mod+Return { spawn "bash" "-c" "~/.config/niri/scripts/terminal-smart.sh"; }
    Mod+grave { spawn "omarchy-agent"; }

    // ── Apps (matches Omarchy conventions) ──
    Mod+Shift+B { spawn "xdg-open" "https://"; }
    Mod+Shift+E { spawn "xdg-terminal-exec" "-e" "nvim"; }
    Mod+Shift+F { spawn "nautilus" "--new-window"; }
    Mod+Shift+M { spawn "spotify"; }
    Mod+Ctrl+D { spawn "vesktop"; }
    Mod+Ctrl+M { spawn "brave-origin-beta" "--app=https://www.messenger.com"; }
    XF86Tools { spawn "kitty" "--class=org.omarchy.ff" "fish" "-c" "ff; exec fish"; }
    XF86Launch5 { spawn "brave-origin-beta" "--app=https://gemini.google.com/app"; }
    XF86Launch6 { spawn "brave-origin-beta" "--app=https://photopea.com"; }

    // ── Close & quit ──
    Mod+Q { close-window; }

    // ── Focus (arrow keys) ──
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }

    // ── Move (arrow keys) ──
    Mod+Ctrl+Left { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Down { move-window-down; }
    Mod+Ctrl+Up { move-window-up; }

    // ── Focus (vim-style) ──
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-down; }

    // ── Move (vim-style) ──
    Mod+Ctrl+H { move-column-left; }
    Mod+Ctrl+J { move-window-down; }
    Mod+Ctrl+K { move-window-up; }

    // ── Workspaces ──
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // ── Workspace navigation ──
    Mod+U { focus-workspace-down; }
    Mod+I { focus-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+Shift+Down { move-column-to-workspace-down; }
    Mod+Shift+Up { move-column-to-workspace-up; }

    // ── Column management ──
    Mod+BracketLeft { consume-window-into-column; }
    Mod+BracketRight { expel-window-from-column; }
    Mod+F { maximize-column; }
    Mod+Ctrl+F { fullscreen-window; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { toggle-column-tabbed-display; }

    // ── Floating ──
    Mod+Shift+Space { toggle-window-floating; }
    Mod+P { focus-floating; }
    Mod+Shift+P { focus-tiling; }

    // ── Screenshots ──
    Mod+Print { spawn-sh "grim -g \"$(slurp)\" - | wl-copy"; }
    Ctrl+Print { spawn-sh "grim -g \"$(slurp)\" ~/Pictures/Screenshots/\"$(date +%Y-%m-%d_%H-%M-%S).png\""; }
    Alt+Print { spawn-sh "grim - | wl-copy"; }

    // ── Clipboard (wtype for GUI apps, terminals use Shift+Ctrl+C/V) ──
    Mod+C { spawn-sh "wtype -M ctrl -k c"; }
    Mod+V { spawn-sh "wtype -M ctrl -k v"; }
    Mod+X { spawn-sh "wtype -M ctrl -k x"; }

    // ── Media keys ──
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }

    // ── Brightness ──
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }

    // ── Lock ──
    Mod+Ctrl+L { spawn "noctalia" "msg" "session" "lock"; }

    // ── Clipboard ──
    Mod+Ctrl+V { spawn "noctalia" "msg" "clipboard-toggle"; }

    // ── Notifications ──
    Mod+Ctrl+Comma { spawn "noctalia" "msg" "notification-clear-active"; }
    Mod+Ctrl+Period { spawn "noctalia" "msg" "notification-clear-history"; }

    // ── Overview ──
    Mod+O { toggle-overview; }

    // ── Power menu ──
    Mod+Escape { spawn "noctarchy-power"; }

    // ── Noctalia-specific ──
    Mod+N { spawn "noctalia" "msg" "panel-toggle" "notifications"; }
}

// ──────────────────────────────────────────────
// Window rules
// ──────────────────────────────────────────────

// Floating dialogs
window-rule {
    match app-id="pavucontrol"
    open-floating true
}

window-rule {
    match app-id="nm-connection-editor"
    open-floating true
}

window-rule {
    match app-id="blueman-manager"
    open-floating true
}

window-rule {
    match app-id="org.gnome.Calculator"
    open-floating true
}

window-rule {
    match app-id="org.gnome.Settings"
    open-floating true
}

window-rule {
    match app-id="feh"
    open-floating true
}

window-rule {
    match app-id="imv"
    open-floating true
}

// Default terminal
window-rule {
    match app-id="Alacritty"
    default-column-width { proportion 0.5; }
}

// Fastfetch — full width
window-rule {
    match app-id="org.omarchy.ff"
    default-column-width { proportion 1.0; }
    open-maximized true
}

// DP-1: ws1=browser, ws2=files, ws3=spotify, ws4=games
// HDMI-A-1: ws1=vesktop, ws2=messenger, ws3=terminal

// Browser → workspace 1, maximized
window-rule {
    match app-id="zen|zen-alpha|zen-beta"
    open-on-workspace "1"
    open-maximized true
}

window-rule {
    match app-id="chromium"
    open-on-workspace "1"
    open-maximized true
}

window-rule {
    match app-id="brave-browser"
    open-on-workspace "1"
    open-maximized true
}

window-rule {
    match app-id="firefox"
    open-on-workspace "1"
    open-maximized true
}

// Nautilus → workspace 2, maximized
window-rule {
    match app-id="org.gnome.Nautilus"
    open-on-workspace "2"
    open-maximized true
}

// Spotify → workspace 3, maximized
window-rule {
    match app-id="spotify"
    open-on-workspace "3"
    open-maximized true
}

// Messenger webapp — full width
window-rule {
    match app-id="brave-www.messenger.com__-Default"
    default-column-width { proportion 1.0; }
    open-maximized true
}

// Gemini webapp — full width
window-rule {
    match app-id="brave-gemini.google.com__app-Default"
    default-column-width { proportion 1.0; }
    open-maximized true
}

// Photopea webapp — full width
window-rule {
    match app-id="brave-photopea.com__-Default"
    default-column-width { proportion 1.0; }
    open-maximized true
}

// Games → workspace 4, maximized
window-rule {
    match app-id="steam|steamwebhelper|steam_app"
    open-on-workspace "4"
    open-maximized true
}

window-rule {
    match app-id="gamescope"
    open-on-workspace "4"
    open-maximized true
}

// Vesktop/Discord → workspace 1, maximized
window-rule {
    match app-id="discord|vesktop"
    open-on-workspace "1"
    open-maximized true
}

// Messenger → workspace 2, maximized
window-rule {
    match app-id="Messenger"
    open-on-workspace "2"
    open-maximized true
}

// Terminal — opens on current workspace
// (HDMI-A-1 ws3 doesn't exist yet; rule removed)

// Screensaver — fullscreen on all monitors
window-rule {
    match app-id="noctarchy-screensaver"
    open-fullscreen true
}

// Layer rules — blur background for bars/overlays
layer-rule {
    match namespace="fuzzel"
    background-effect {
        blur true
    }
}

layer-rule {
    match namespace="noctalia"
    background-effect {
        blur true
    }
}

// Opacity rules — transparency for terminals and apps
window-rule {
    match app-id="alacritty"
    opacity 0.85
}

window-rule {
    match app-id="kitty"
    opacity 0.85
    draw-border-with-background false
}

window-rule {
    match app-id="org.omarchy.ff"
    opacity 0.85
    draw-border-with-background false
}

window-rule {
    match app-id="foot"
    opacity 0.85
}

window-rule {
    match app-id="org.gnome.Nautilus"
    opacity 0.90
}

// ──────────────────────────────────────────────
// Spawn at startup
// ──────────────────────────────────────────────

spawn-at-startup "noctalia"
spawn-at-startup "swayidle" "-w" "timeout" "600" "niri msg action power-off-monitors"
spawn-sh-at-startup "systemctl --user import-environment $(env | cut -d= -f1) && dbus-update-activation-environment --systemd --all"

// ──────────────────────────────────────────────
// Xwayland
// ──────────────────────────────────────────────

xwayland-satellite { path "xwayland-satellite"; }

// ──────────────────────────────────────────────
// Clipboard
// ──────────────────────────────────────────────

clipboard { disable-primary; }

// ──────────────────────────────────────────────
// Blur
// ──────────────────────────────────────────────

blur {
    passes 3
    offset 3.0
    noise 0.02
    saturation 1.5
}

// ──────────────────────────────────────────────
// Hotkey overlay
// ──────────────────────────────────────────────

hotkey-overlay {
    hide-not-bound
}

// ──────────────────────────────────────────────
// Config notification
// ──────────────────────────────────────────────

config-notification {
    // disable-failed
}

// ──────────────────────────────────────────────
// Screenshot path
// ──────────────────────────────────────────────

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// ──────────────────────────────────────────────
// Prefer no CSD
// ──────────────────────────────────────────────

prefer-no-csd
