#!/bin/bash

# Mod+Ctrl+T: toggle a btop terminal.
#   - If a kitty window running btop already exists, focus it (and its
#     workspace/output) instead of opening a duplicate.
#   - Otherwise spawn one on the current workspace.

btop_win=$(niri msg --json windows 2>/dev/null | python3 -c '
import sys, json
try:
    wins = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for w in wins:
    if w.get("app-id") == "kitty" and w.get("title", "").strip() == "btop":
        print(w["id"])
        sys.exit(0)
sys.exit(0)
')

if [[ -n "$btop_win" ]]; then
    niri msg action focus-window --id "$btop_win" 2>/dev/null
    exit 0
fi

TERM_CMD=$(grep '^terminal' ~/.config/noctalia/config.toml 2>/dev/null | cut -d'"' -f2)
TERM_CMD=${TERM_CMD:-kitty}

exec "$TERM_CMD" --title btop -e btop
