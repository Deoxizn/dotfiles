# Arch Updater 2.0.2 -> Noctarchy hook
# Makes buildTerminalCommand() honor update_cmd (like buildBackgroundCommand)
# and defaults to noctarchy-update-run (Super+Alt+Space > System Update > Noctarchy)
# Apply to: ~/.local/state/noctalia/plugins/materialized/community/arch-updater/service.luau
# Patch with: patch -p1 < arch-updater-noctarchy.patch
# Or via setup.sh auto-apply.
--- a/service.luau
+++ b/service.luau
@@ -1061,6 +1061,13 @@
 -- the PKGBUILD review work as usual. Output is tee'd into the same log so the
 -- engine still sees the "::EXIT" marker and re-checks when the run ends.
 local function buildTerminalCommand()
+    local override = trim(cfg("update_cmd"))
+    if override ~= "" then
+        return override
+    end
+    if noctalia.commandExists("noctarchy-update-run") then
+        return "noctarchy-update-run"
+    end
+
     local ignored = ignoreList()
     local ignoreFlag = #ignored > 0 and (" --ignore " .. table.concat(ignored, ",")) or ""
 
