// Hexciri — Niri config (entry point)
// https://github.com/deoxizn/hexciri
//
// This file is the entry point only: it includes the per-concern fragments
// below. niri merges their sections and live-reloads EVERY included file —
// edit any fragment and the running session applies it immediately.
//
//   include "cursors.kdl"        // cursor { } — cursor theme/size (per-machine)
//   include "env.kdl"            // environment { } — Wayland hints for every app
//   include "monitors.kdl"       // output { } — screens, scale, mode, VRR
//   include "input.kdl"          // input { } — keyboard layout, touchpad, mouse
//   include "looknfeel.kdl"     // layout borders/focus-ring/shadow, blur,
//                                //   animations, hotkey-overlay (theme-owned feel)
//   include "window-rules.kdl"   // workspace names + window-rule + layer-rule
//   include "keybinds.kdl"       // binds { } — rendered from config/keybinds/intents.toml
//   include "autostart.kdl"      // spawn-at-startup — boot-time services & shell
//
// Split so each concern is easy to find, edit and back up on its own.
// To add MORE custom keybinds without touching the schema, append a
// `binds { ... }` block here after the includes — extra bind sections merge.

include "cursors.kdl"
include "env.kdl"
include "monitors.kdl"
include "input.kdl"
include "looknfeel.kdl"
include "window-rules.kdl"
include "keybinds.kdl"
include "autostart.kdl"

// ──────────────────────────────────────────────
// Layout — the static parts of how columns are arranged.
// The theme parts (border, focus-ring, shadow, blur) live in looknfeel.kdl
// so theme changes never touch your spacing tweaks.
// ──────────────────────────────────────────────

layout {
    gaps 0                                  // Pixel gap between windows
    center-focused-column "on-overflow"     // Center the focused column when it overflows the screen

    // Preset column widths you can cycle through with Mod+R
    preset-column-widths {
        proportion 0.33333                  // 1/3 of screen width
        proportion 0.5                      // 1/2 of screen width
        proportion 0.66667                  // 2/3 of screen width
    }

    default-column-width { proportion 0.5; }  // New windows open at half screen width

    struts {
        // left 64                          // Space reserved on left edge (for panels/bars)
        // right 64                         // Space reserved on right edge
        // top 64                           // Space reserved on top edge
        // bottom 64                        // Space reserved on bottom edge
    }
}

// ──────────────────────────────────────────────
// Overview (Mod+O)
// Shows a zoomed-out view of all your workspaces.
// ──────────────────────────────────────────────

overview {
    zoom 0.5                                // How much to zoom out (0.5 = half size)
    backdrop-color "#262626"                // Background color behind workspaces
}

// ──────────────────────────────────────────────
// Xwayland
// Runs X11 apps under Wayland via xwayland-satellite.
// Needed for older apps that don't support Wayland natively.
// ──────────────────────────────────────────────

xwayland-satellite { path "xwayland-satellite"; }

// ──────────────────────────────────────────────
// Clipboard
// Disables the X11 primary selection (middle-click paste).
// Only Ctrl+C/V/X clipboard works.
// ──────────────────────────────────────────────

clipboard { disable-primary; }

// ──────────────────────────────────────────────
// Config notification
// Shows a notification when the config fails to load.
// ──────────────────────────────────────────────

config-notification {
    // disable-failed                       // Uncomment to suppress config error notifications
}

// ──────────────────────────────────────────────
// Screenshot path
// Where screenshots are saved when using Ctrl+Print or Alt+Print.
// %Y-%m-%d %H-%M-%S is replaced with the current date/time.
// ──────────────────────────────────────────────

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// ──────────────────────────────────────────────
// Prefer no CSD
// Ask apps to not draw their own title bar decorations.
// Niri will draw server-side decorations instead.
// ──────────────────────────────────────────────

prefer-no-csd