#!/bin/bash
# noctarchy:summary=Launch OpenRGB (system package) for this desktop.
# Rewired 2026-10-17 from the old extracted-AppImage path
# (~/appimg/openrgb/OpenRGB-extracted/...) to the Arch repo binary.
# The deoxizn.orp / OpenRGB.json profile in ~/.config/OpenRGB survived the
# WM swap; OpenRGB's built-in AutoStart (enabled, profile=deoxizn) applies it.
# No --profile flag here on purpose: the orp pins device locations that must
# match what OpenRGB detects on THIS board — let the saved profile drive it.

exec /usr/bin/openrgb "$@"
