#!/bin/bash
# noctarchy:summary=Launch OpenRGB (extracted AppImage) via XWayland.
# OpenRGB's Qt AppImage bundles only the xcb (X11) platform plugin, so under
# Niri XWayland it needs DISPLAY. Rely on the ambient DISPLAY that niri already
# exports (uses the running Xwayland instance, e.g. :1 via xwayland-satellite);
# runs the stable extracted binary (avoids the AppImage's per-run
# /tmp/.mount_* regeneration that broke autostart).

exec env "$HOME/appimg/openrgb/OpenRGB-extracted/usr/bin/OpenRGB" --profile "$HOME/.config/OpenRGB/deoxizn.orp" "$@"