{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "mod": "dock",
  "margin-top": 1,
  "height": 10,
  "margin-bottom": 2,
  "modules-left": [],

  //"modules-center": ["hyprland/window"],
  "modules-center": [
    "mpris",
    "hyprland/workspaces",
    "custom/updatespacman",
    "custom/update",
    "custom/screenrecording-indicator",
    "tray",
    "idle_inhibitor",
    "custom/sysinfo",
  ],

  //"modules-right": ["group/group-power"],
  "modules-right": [],

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "warp-on-scroll": false,
    "sort-by-number": true,
    "show-special": false,
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "format": "{windows}",
    "format-window-separator": " ",
    "window-rewrite-default": "",
    "window-rewrite": {
      "title<.*amazon.*>": "",
      "class<firefox|org.mozilla.firefox|librewolf|floorp|mercury-browser|[Cc]achy-browser>": "",
      "class<zen>": "󰰷",
      "class<waterfox|waterfox-bin>": "",
      "class<microsoft-edge>": "",
      "class<Chromium|Thorium|[Cc]hrome>": "",
      "class<brave-browser>": "🦁",
      "class<tor browser>": "",
      "class<firefox-developer-edition>": "🦊",
      "class<kitty|konsole>": "",
      "class<kitty-dropterm>": "",
      "class<com.mitchellh.ghostty>": "",
      "class<org.wezfurlong.wezterm>": "",
      "class<[Tt]hunderbird|[Tt]hunderbird-esr>": "",
      "class<eu.betterbird.Betterbird>": "",
      "title<.*gmail.*>": "󰊫",
      "class<[Tt]elegram-desktop|org.telegram.desktop|io.github.tdesktop_x64.TDesktop>": "",
      "class<discord|[Ww]ebcord|Vesktop>": "",
      "title<.*whatsapp.*>": "",
      "title<.*zapzap.*>": "",
      "title<.*messenger.*>": "",
      "title<.*facebook.*>": " ",
      "title<.*reddit.*>": "",
      "class<.*reddit.*>": "",
      "title<.*ChatGPT.*>": "󰚩",
      "class<.*ChatGPT.*>": "󰚩",
      "title<.*deepseek.*>": "󰚩",
      "title<.*qwen.*>": "󰚩",
      "class<subl>": "󰅳",
      "class<slack>": "",
      "class<mpv>": "",
      "class<celluloid|Zoom>": "",
      "class<Cider>": "󰎆 ",
      "title<.*Picture-in-Picture.*>": "",
      "title<.*[Yy]ou[Tt]ube [Mm]usic.*>": "󰻂",
      "class<.*[Yy]ou[Tt]ube [Mm]usic.*>": "󰻂",
      "title<.*youtube.*>": "",
      "class<vlc>": "󰕼",
      "title<.*cmus.*>": "",
      "class<[Ss]potify>": "",
      "class<virt-macodeger>": "",
      "class<.virt-manager-wrapped>": "",
      "class<virtualbox manager>": "💽",
      "title<virtualbox>": "💽",
      "class<remmina>": "🖥️",
      "class<VSCode|code-url-handler|code-oss|codium|codium-url-handler|VSCodium>": "󰨞",
      "class<dev.zed.Zed>": "󰵁",
      "class<codeblocks>": "󰅩",
      "title<.*github.*>": "",
      "class<mousepad>": " ",
      "class<libreoffice-writer>": " ",
      "class<libreoffice-startcenter>": " 󰏆",
      "class<libreoffice-calc>": "",
      "title<.*nvim ~.*>": "",
      "class<org.gnome.Nautilus>": "󱧶",
      "title<.*vim.*>": "",
      "title<.*figma.*>": "",
      "title<.*jira.*>": "",
      "class<jetbrains-idea>": "",
      "title<*.VSCode.*>": "󰨞",
      "class<.*code.*>": "󰨞",
      "class<obs|com.obsproject.Studio>": "",
      "class<polkit-gnome-authentication-agent-1>": "󰒃",
      "class<nwg-look>": "",
      "class<[Pp]avucontrol|org.pulseaudio.pavucontrol>": "󱡫",
      "class<steam>": "",
      "class<thunar|nemo>": "󱧶",
      "class<Gparted>": "",
      "class<gimp>": "",
      "class<emulator>": "📱",
      "class<android-studio>": "",
      "class<org.pipewire.Helvum>": "󰓃",
      "class<localsend>": "",
      "class<PrusaSlicer|UltiMaker-Cura|OrcaSlicer>": "󰹛",
      "title<.*instagram.*>": "",
      "title<.*plex.*>": "󰚺",
      "title<.*karakeep.*>": "󰃀",
      "title<.*homepage.*>": "󰋜",
      "title<.*freshrss.*>": "󰑫",
      "title<.*World Of Warcraft.*>": "󰺶",
      "title<.*messages.*>": "󰵅",
    },
  },
  "custom/update": {
    "format": "",
    "exec": "omarchy-update-available",
    "on-click": "omarchy-launch-floating-terminal-with-presentation omarchy-update",
    "tooltip-format": "Omarchy update available",
    "signal": 7,
    "interval": 21600,
  },
  "custom/updatespacman": {
    "format": "{}{icon}",
    "return-type": "json",
    "format-icons": {
      "has-updates": " 󰏖",
      "updated": "",
    },
    "exec-if": "which waybar-module-pacman-updates",
    "exec": "waybar-module-pacman-updates --no-zero-output",
  },
  "custom/sysinfo": {
    "exec": "~/.config/waybar/scripts/sysinfo.sh",
    "return-type": "json",
    "format": "󰌢",
    "interval": 2,
    "on-click": "omarchy-launch-or-focus-tui btop",
  },
  "custom/voxtype": {
    "exec": "omarchy-voxtype-status",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "idle": "",
      "recording": "󰍬",
      "transcribing": "󰔟",
    },
    "tooltip": true,
    "on-click-right": "omarchy-voxtype-config",
    "on-click": "omarchy-voxtype-model",
  },
  "mpris": {
    "format": "{player_icon} {artist} - {title}",
    "format-paused": "{status_icon}",
    "player-icons": {
      "default": "󰎈",
      "spotify": "",
      "chromium": "",
      "firefox": "",
      "brave": "󰖟",
      "youtube-music": "󰎆",
    },
    "status-icons": {
      "paused": "󰏤",
    },
    "max-length": 80,
    "interval": 1,
  }, // This brace and comma were missing or misplaced

  "custom/screenrecording-indicator": {
    "on-click": "omarchy-cmd-screenrecord",
    "exec": "$OMARCHY_PATH/default/waybar/indicators/screen-recording.sh",
    "signal": 8,
    "return-type": "json",
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": "",
    },
  },
  "tray": {
    "icon-size": 12,
    "spacing": 5,
    "show-passive-items": true,
  },
} // Ensure there is only one final closing brace here [cite: 11]
