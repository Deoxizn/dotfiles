#!/bin/bash

set -e

# Only invite when there's a reader to use and it isn't set up yet (the lock
# PAM file is the last thing the setup writes on success).
if hexciri-hw-fingerprint && [[ ! -f /etc/pam.d/hexciri-lock-fingerprint ]] &&
  hexciri-done ensure fingerprint-setup-invitation; then
  hexciri-notification-send -u critical -g 󰈷 "Setup Fingerprint Reader" \
    "Enable sudo and unlocking with your fingerprint." \
    --exec hexciri-launch-floating-terminal-with-presentation hexciri-setup-security-fingerprint
fi
