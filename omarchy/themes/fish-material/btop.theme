# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#0a0a0d"

# Main text color
theme[main_fg]="#f2ffff"

# Title color for boxes
theme[title]="#f2ffff"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#d2787d"

# Background color of selected item in processes box. #f0ffff maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #22262c gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#22262c"

# Foreground color of selected item in processes box. Use #f2ffff so
# the row text stays readable on the lighter_bg highlight; the previous
# #d2787d produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#f2ffff"

# Color of inactive/disabled text
theme[inactive_fg]="#5f606c"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #f2ffff caps at #ffffff when the foreground is already pure white, so we
# just bind it to #f2ffff directly.
theme[graph_text]="#f2ffff"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #f0ffff collapsed to the main fg.
theme[meter_bg]="#22262c"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #5ab7d5 for a distinct accent instead of #f2ffff which capped to white.
theme[proc_misc]="#5ab7d5"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#5e5f6b"
theme[mem_box]="#47a6c4"
theme[net_box]="#c46b71"
theme[proc_box]="#d2787d"

# Box divider line and small boxes line color
theme[div_line]="#5f606c"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#47a6c4"
theme[temp_mid]="#ffb0b5"
theme[temp_end]="#c46b71"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#5ab7d5"
theme[cpu_mid]="#7694b7"
theme[cpu_end]="#5e5f6b"

# Mem/Disk free meter
theme[free_start]="#5e5f6b"
theme[free_mid]="#7694b7"
theme[free_end]="#5ab7d5"

# Mem/Disk cached meter
theme[cached_start]="#7694b7"
theme[cached_mid]="#5ab7d5"
theme[cached_end]="#5e5f6b"

# Mem/Disk available meter
theme[available_start]="#ffb0b5"
theme[available_mid]="#c46b71"
theme[available_end]="#c46b71"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#47a6c4"
theme[used_mid]="#5ab7d5"
theme[used_end]="#7694b7"

# Download graph colors
theme[download_start]="#ffb0b5"
theme[download_mid]="#c46b71"
theme[download_end]="#c46b71"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#47a6c4"
theme[upload_mid]="#5ab7d5"
theme[upload_end]="#7694b7"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#5ab7d5"
theme[process_mid]="#7694b7"
theme[process_end]="#5e5f6b"
