# /etc/fstab: static file system information.
#
# Use 'blkid' to print the universally unique identifier for a device; this may
# be used with UUID= as a more robust way to name devices that works even if
# disks are added and removed. See fstab(5).
#
# <file system>             <mount point>  <type>  <options>  <dump>  <pass>
UUID=1B64-504B                            /boot          vfat    defaults,umask=0077 0 2
UUID=5f40a4c4-2848-419f-8b5a-7710933307f2 /              btrfs   subvol=/@,defaults,noatime,compress=zstd:1 0 0
UUID=5f40a4c4-2848-419f-8b5a-7710933307f2 /home          btrfs   subvol=/@home,defaults,noatime,compress=zstd:1 0 0
UUID=5f40a4c4-2848-419f-8b5a-7710933307f2 /root          btrfs   subvol=/@root,defaults,noatime,compress=zstd:1 0 0
UUID=5f40a4c4-2848-419f-8b5a-7710933307f2 /srv           btrfs   subvol=/@srv,defaults,noatime,compress=zstd:1 0 0
UUID=5f40a4c4-2848-419f-8b5a-7710933307f2 /var/cache     btrfs   subvol=/@cache,defaults,noatime,compress=zstd:1 0 0
UUID=5f40a4c4-2848-419f-8b5a-7710933307f2 /var/tmp       btrfs   subvol=/@tmp,defaults,noatime,compress=zstd:1 0 0
UUID=5f40a4c4-2848-419f-8b5a-7710933307f2 /var/log       btrfs   subvol=/@log,defaults,noatime,compress=zstd:1 0 0
tmpfs                                     /tmp           tmpfs   defaults,noatime,mode=1777 0 0

